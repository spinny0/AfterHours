{
  "manifest_version": 3,
  "name": "AfterHours",
  "version": "1.4.0",
  "description": "Shares the focused website domain with AfterHours on this PC.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "not_allowed",
  "action": {
    "default_title": "AfterHours",
    "default_popup": "popup.html"
  },
  "key": ""
}
